# LLM配置
OPENAI_API_KEY=2486
OPENAI_BASE_URL=http://host.docker.internal:8000
CHAT_MODEL=Qwen3.5-9B-MLX-4bit

# Embedding配置
EMBEDDING_MODEL=bge-m3-mlx-fp16
EMBEDDING_BASE_URL=http://host.docker.internal:8000
EMBEDDING_API_KEY=2486
EMBEDDING_DIMENSIONS=1024

# Redis配置
REDIS_URL=redis://localhost:6379

# PostgreSQL配置
POSTGRES_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dawn

# Agent配置
SYSTEM_PROMPT=You are a helpful AI assistant.
MAX_STEPS=10
PLAN_ENABLED=true
STREAM_TIMEOUT_MS=120000
MAX_SUBAGENT_DISPATCHES=3

# SSE配置
SHOW_STEPS=false

# Langfuse配置（可选）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
