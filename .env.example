# oMLX - LLM
OPENAI_API_KEY=2486
BASE_URL=http://host.docker.internal:8000
CHAT_MODEL=Qwen3.5-9B-MLX-4bit

# oMXL - EMBEDDING MODEL
EMBEDDING_BASE_URL=http://host.docker.internal:8000
EMBEDDING_API_KEY=2486
EMBEDDING_DIMENSIONS=1024
EMBEDDING_MODEL=bge-m3-mlx-fp16

# qwen
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/
CHAT_MODEL=qwen3.6-plus

# openrouter
BASE_URL=https://openrouter.ai/api
CHAT_MODEL=

# mimo
BASE_URL=https://token-plan-sgp.xiaomimimo.com
CHAT_MODEL=mimo-v2.5-pro

# TAVILY KEY
TAVILY_API_KEY=

# ───────── Langfuse Cloud (JP Region, 默认) ─────────
# 在 https://jp.cloud.langfuse.com 创建项目并生成 API Keys，填入下方后运行：
#   ./scripts/langfuse-auth-header.sh
# 将输出填入 LANGFUSE_AUTH_BASE64。
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
LANGFUSE_SECRET_KEY=sk-lf-replace-me
LANGFUSE_OTLP_ENDPOINT=https://jp.cloud.langfuse.com/api/public/otel/v1/traces
LANGFUSE_AUTH_BASE64=
LANGFUSE_ENVIRONMENT=dev
# Spring Boot 原生开关：management.tracing.enabled。
# 填好真实 LANGFUSE_AUTH_BASE64 后设为 true；未配置 Key 时设为 false 避免 401 warn。
MANAGEMENT_TRACING_ENABLED=true
